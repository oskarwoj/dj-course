erDiagram
    %% ============================================================
    %% USER & AUTH
    %% ============================================================
    USER ||--o{ NOTIFICATION : "receives"
    USER ||--o{ DRIVER : "manages"

    %% ============================================================
    %% DRIVER RELATIONSHIPS
    %% ============================================================
    DRIVER ||--o{ CALENDAR_EVENT : "has"
    DRIVER ||--o{ DRIVER_ROUTE : "completes"
    DRIVER ||--o{ EXPENSE : "reports"
    DRIVER ||--o| VEHICLE : "currently_assigned_to"

    %% ============================================================
    %% VEHICLE RELATIONSHIPS
    %% ============================================================
    VEHICLE ||--o{ MAINTENANCE_TASK : "scheduled"
    VEHICLE ||--o{ MAINTENANCE_RECORD : "has_history"
    VEHICLE ||--o{ VEHICLE_DOCUMENT : "has"
    VEHICLE ||--o{ EXPENSE : "incurs"
    VEHICLE ||--o{ SHIPMENT : "used_in"

    %% ============================================================
    %% SHIPMENT RELATIONSHIPS
    %% ============================================================
    SHIPMENT ||--o{ EXPENSE : "generates"

    %% ============================================================
    %% ORDER RELATIONSHIPS
    %% ============================================================
    ORDER ||--o{ ORDER_EVENT : "logs"
    ORDER ||--o{ TRACKING_EVENT : "tracks"
    ORDER ||--o{ PAYMENT : "generates"
    ORDER ||--o{ EXPENSE : "incurs"

    %% ============================================================
    %% POLYMORPHIC DOCUMENT SYSTEM
    %% ============================================================
    %% Documents can link to: vehicles, drivers, customers, suppliers, company

    %% ============================================================
    %% CORE ENTITIES
    %% ============================================================

    USER {
        uuid id PK
        string name
        string email
        string company
        string avatar_url
        timestamp created_at
        timestamp updated_at
    }

    DRIVER {
        uuid id PK
        string name
        string email
        string phone
        string license_number
        date license_expiry
        date hire_date
        string contract_type
        decimal salary
        string currency
        string status
        jsonb address
        jsonb emergency_contact
        jsonb current_location
        timestamp created_at
        timestamp updated_at
    }

    DRIVER_ROUTE {
        uuid id PK
        uuid driver_id FK
        string name
        timestamp start_date
        timestamp end_date
        string origin
        string destination
        decimal distance
        string status
        jsonb route_points
        timestamp created_at
    }

    CALENDAR_EVENT {
        uuid id PK
        uuid driver_id FK
        string title
        timestamp start_time
        timestamp end_time
        string event_type
        text description
        uuid route_id
        timestamp created_at
    }

    VEHICLE {
        uuid id PK
        string plate_number
        string make
        string model
        integer year
        string vehicle_type
        string status
        integer mileage
        uuid current_driver_id
        jsonb capacity
        jsonb cargo_types
        jsonb current_location
        jsonb ownership
        timestamp created_at
        timestamp updated_at
    }

    VEHICLE_DOCUMENT {
        uuid id PK
        uuid vehicle_id FK
        string doc_type
        string number
        date issue_date
        date expiry_date
        string issuing_authority
        text notes
        timestamp created_at
    }

    MAINTENANCE_RECORD {
        uuid id PK
        uuid vehicle_id FK
        date service_date
        string record_type
        text description
        decimal cost
        integer mileage
        decimal duration_hours
        string service_provider
        string technician
        string status
        text notes
        timestamp created_at
    }

    MAINTENANCE_TASK {
        uuid id PK
        uuid vehicle_id FK
        text description
        string priority
        string status
        string task_type
        date due_date
        decimal estimated_cost
        decimal estimated_duration_hours
        string assigned_to
        text notes
        timestamp created_at
        timestamp updated_at
    }

    SHIPMENT {
        uuid id PK
        string name
        string customer
        string priority
        timestamp created_at
        date due_date
        jsonb route_data
    }

    ORDER {
        uuid id PK
        string customer
        string status
        decimal amount
        string currency
        timestamp order_date
        jsonb state_data
        timestamp created_at
        timestamp updated_at
    }

    ORDER_EVENT {
        uuid id PK
        uuid order_id FK
        string event_status
        timestamp event_timestamp
        text description
        string employee
        text details
    }

    TRACKING_EVENT {
        uuid id PK
        uuid order_id FK
        string status
        string location
        timestamp event_timestamp
        text description
    }

    EXPENSE {
        uuid id PK
        date expense_date
        string expense_type
        string category
        decimal amount
        string currency
        string status
        uuid driver_id
        uuid vehicle_id
        uuid shipment_id
        integer odometer
        text notes
        string vendor
        string invoice_number
        date payment_due_date
        string payment_status
        boolean is_recurring
        jsonb attachments
        timestamp created_at
        timestamp updated_at
    }

    PAYMENT {
        uuid id PK
        uuid order_id FK
        decimal amount
        string currency
        string status
        date due_date
        date payment_date
        string payer
        string payee
        string transaction_id
        string invoice_link
        string payment_method
        timestamp created_at
        timestamp updated_at
    }

    DOCUMENT {
        uuid id PK
        string name
        string doc_type
        string entity_type
        uuid entity_id
        string entity_name
        string number
        date issue_date
        date expiry_date
        string issuing_authority
        string file_url
        integer file_size_bytes
        string mime_type
        text notes
        timestamp created_at
        timestamp updated_at
    }

    NOTIFICATION {
        uuid id PK
        uuid user_id FK
        string notification_type
        text message
        timestamp notification_time
        boolean is_read
        timestamp created_at
    }
